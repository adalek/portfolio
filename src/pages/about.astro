---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About / Xuwen Dong" description="About Xuwen Dong, a technical artist and game designer exploring real-time graphics, procedural tools, and interactive systems.">
  <main class="page-shell">
    <section class="narrow">
      <p class="eyebrow">About</p>
      <h1 class="section-title">Xuwen Dong</h1>
      <div class="about-copy">
        <p>I am a technical artist and game designer interested in the space between visual ideas and working systems. My practice includes real-time graphics, procedural tools, simulation, interactive experiences, and gameplay prototyping.</p>
        <p>I enjoy turning experiments into practical workflows and playable results. Across individual and collaborative projects, I work through research, rapid prototyping, technical problem-solving, and visual iteration, using each project to explore how technology can support a clear creative direction.</p>
        <p>Contact: <a href="https://www.linkedin.com/in/xuwen-dong/" target="_blank" rel="noreferrer">LinkedIn</a></p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .about-copy {
    margin-top: 40px;
  }

  p {
    color: var(--muted);
    font-size: clamp(19px, 3vw, 28px);
    line-height: 1.55;
  }

  a {
    color: var(--text);
    text-decoration: underline;
  }
</style>
